{
  "name": "site-creator-vinext-starter",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/start-monitored.mjs --dev",
    "dev:local": "node scripts/start-local.mjs",
    "build": "next build",
    "start": "node scripts/start-monitored.mjs",
    "railway:start": "npm run db:migrate && npm run account:provision && npm run start",
    "account:provision": "node --import ./tests/ts-loader.mjs scripts/provision-pilot.ts",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:watch": "node --import ./tests/ts-loader.mjs --test tests/similarity.test.mjs tests/watch-list.test.mjs && node --import ./tests/ts-loader.mjs tests/watch-integration.mjs",
    "test:cost-control": "node --import ./tests/ts-loader.mjs --test tests/snapshot-client.test.mjs tests/watch-page.test.mjs && node --import ./tests/ts-loader.mjs tests/watch-integration.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@phosphor-icons/react": "^2.1.10",
    "docx": "^9.7.2",
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "next": "^16.3.5",
    "pdf-lib": "1.17.1",
    "postgres": "^3.4.9",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "^0.34.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.2.6",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.2",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
