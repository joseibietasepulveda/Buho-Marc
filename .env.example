DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/buho_marc
SOURCE_PROVIDER=simulated
# Set SOURCE_PROVIDER=inapi and configure this server-only key for the real source.
INAPI_API_KEY=
# Puntual recovery only, after an import/review with missing legal antecedents.
# Official public API uses its own temporary context; this is not a second key.
INAPI_DIRECT_RECOVERY_ENABLED=true
INAPI_DIRECT_RECOVERY_DAILY_LIMIT=200
MONITORING_SCHEDULER_ENABLED=false
MONITORING_CRON_SECRET=
# Demo-only exact attribute lookup; the real API currently accepts application numbers.
NEXT_PUBLIC_MOCK_ATTRIBUTE_SEARCH=true
# Initial provisioning only; existing account passwords are never replaced.
DANIEL_INITIAL_PASSWORD=
# Enable access for the existing administrator of the previous demo workspace.
BUHO_INITIAL_PASSWORD=
# Public HTTPS origin for write validation behind a reverse proxy.
APP_PUBLIC_ORIGIN=
# Optional server-only assistance for feasibility conclusions. Empty uses deterministic text.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4.1-mini

# Resumen semanal: piloto fijo hacia hola@rcirculo.com; lunes 08:30 America/Santiago.
# Clave separada de factibilidad, únicamente en el servidor.
OPENROUTER_WATCH_API_KEY=
RESEND_API_KEY=
RESEND_DELIVERY_ENABLED=false
WATCH_DIGEST_ENABLED=false
# Daily AI review of saved crossings; independent from email delivery.
WATCH_AI_ENABLED=false
# Daily representative discovery, only with the real source and active supervisor.
PORTFOLIO_DISCOVERY_ENABLED=true
WATCH_GLM_RUN_BUDGET_USD=0.10
WATCH_GLM_MONTHLY_BUDGET_USD=10
# APP_PUBLIC_ORIGIN ya está definido arriba: URL pública de esta plataforma.

# Dashboard interno: captura opcional sin contenidos, volcados o datos de clientes.
ADMIN_ANALYTICS_CAPTURE_ENABLED=false
# Provisionar usuario admin sólo en Dev; retirar esta variable después de crearlo.
ANALYTICS_ADMIN_INITIAL_PASSWORD=
# Firma exclusiva del endpoint de eventos de entrega de Resend, sólo servidor.
RESEND_WEBHOOK_SECRET=
